{
  "name": "shumap",
  "version": "1.0.0",
  "description": "Campus map data helpers for SHUMap",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build:cloudflare": "npm run build",
    "build:edgeone": "VITE_ROUTER_MODE=hash npm run build",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "db:migrate:remote": "npx wrangler d1 migrations apply shumap-v2 --remote",
    "db:migrate:local": "npx wrangler d1 migrations apply shumap-v2 --local",
    "db:seed:v2": "node scripts/generate_v2_seed.mjs > output/v2-seed.sql",
    "maps:verify:canonical": "node scripts/sync_campus_map_assets.mjs",
    "maps:upload:canonical": "node scripts/sync_campus_map_assets.mjs --upload-remote",
    "worker:dev": "npm run build && npx wrangler dev",
    "preview": "vite preview",
    "pick:coords": "node scripts/pick_coords_playwright.js",
    "test": "npm run test:unit && npm run test:schema && npm run test:migrations && npm run test:split",
    "test:unit": "node --test tests/*.test.mjs",
    "test:schema": "node scripts/validate_v2_schema.mjs",
    "test:migrations": "node scripts/validate_migration_applicability.mjs",
    "test:split": "node scripts/diagnose_split_completeness.mjs --self-test",
    "test:all": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chromium": "^3.0.3",
    "lucide-react": "^1.25.0",
    "playwright": "^1.52.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "esbuild": "^0.27.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.95.0"
  }
}
