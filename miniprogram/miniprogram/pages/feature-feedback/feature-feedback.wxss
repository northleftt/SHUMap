page { background: #f5f6f8; color: #0f172a; }
.page { padding: 24px 20px; }
.title { font-size: 20px; font-weight: 600; }
.stars { display: flex; justify-content: center; margin: 28px 0; }
.star { font-size: 38px; color: #cbd5e1; padding: 6px; }
.selected { color: #f59e0b; }
textarea { width: 100%; height: 110px; padding: 14px; box-sizing: border-box; background: #fff; border-radius: 12px; font-size: 15px; }
button { margin-top: 20px; border-radius: 24px; background: #1e80c1; color: #fff; font-size: 15px; }
button[disabled] { opacity: .45; background: #1e80c1; color: #fff; }
.muted { color: #64748b; font-size: 13px; text-align: center; margin-top: 12px; }
.error { color: #dc2626; margin-top: 12px; font-size: 13px; }
.thanks { padding-top: 40px; text-align: center; }
