.page {
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

.form {
  padding: 12px 16px 32px;
}

.field-title {
  font-size: 14px;
  line-height: 20px;
  font-weight: 600;
  color: #0f172a;
}

.field-gap {
  margin-top: 20px;
}

.chips {
  margin-top: 10px;
  white-space: nowrap;
}

.chips-inner {
  display: flex;
  flex-direction: row;
}

.chip {
  display: inline-block;
  margin-right: 8px;
  padding: 8px 15px;
  border-radius: 999px;
  border: 1px solid #d7dde4;
  background: #ffffff;
  color: #475569;
  font-size: 13px;
}

.chip-active {
  border-color: #1e80c1;
  background: #e8f1f8;
  color: #1e80c1;
  font-weight: 600;
}

.picker-row,
.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 10px;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}

.picker-row {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding: 0 16px;
}

.picker-value {
  flex: 1;
  font-size: 14px;
  color: #0f172a;
}

.placeholder,
.hint,
.footer-hint,
.state-sub,
.done-sub {
  color: #94a3b8;
}

.chevron {
  font-size: 18px;
  color: #94a3b8;
  transition: transform 0.15s ease;
}

.chevron-open {
  transform: rotate(90deg);
}

/* 目标选择面板：搜索行 + 校区档 + 候选列表，替代原来几百项的 picker 滚轮。 */
.picker-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8px;
  padding: 12px;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}

.search-row {
  display: flex;
  align-items: center;
  height: 40px;
  padding: 0 12px;
  border-radius: 999px;
  background: #f1f5f9;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 40px;
  font-size: 14px;
  color: #0f172a;
}

.search-clear {
  width: 22px;
  height: 22px;
  margin-left: 6px;
  border-radius: 50%;
  background: #cbd5e1;
  color: #ffffff;
  text-align: center;
  font-size: 15px;
  line-height: 22px;
}

.campus-chips {
  margin-top: 10px;
}

.chip-sm {
  padding: 6px 12px;
  font-size: 12px;
}

.result-list {
  max-height: 260px;
  margin-top: 6px;
}

.result-row {
  padding: 10px 10px;
  border-radius: 10px;
}

.result-active {
  background: #e8f1f8;
}

.result-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.result-name {
  font-size: 14px;
  color: #0f172a;
}

.result-active .result-name {
  color: #1e80c1;
  font-weight: 600;
}

.result-campus {
  margin-left: 6px;
  font-size: 11px;
  color: #94a3b8;
}

.result-hint {
  margin-top: 2px;
  font-size: 11px;
  line-height: 16px;
  color: #94a3b8;
}

.result-empty {
  padding: 18px 10px;
  text-align: center;
  font-size: 12px;
  color: #94a3b8;
}

.textarea {
  min-height: 144px;
  padding: 14px 16px;
  font-size: 14px;
  line-height: 21px;
}

.input {
  height: 48px;
  padding: 0 16px;
  font-size: 14px;
}

.hint {
  margin-top: 8px;
  font-size: 11px;
  line-height: 17px;
}

.photo-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.photo-tile,
.photo-add {
  position: relative;
  width: 92px;
  height: 92px;
  overflow: hidden;
  border-radius: 14px;
  box-sizing: border-box;
}

.photo-tile {
  background: #e2e8f0;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-state {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 8px;
  background: rgba(15, 23, 42, 0.62);
  color: #ffffff;
  text-align: center;
  font-size: 11px;
  line-height: 17px;
}

.photo-error {
  background: rgba(127, 29, 29, 0.72);
}

.photo-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  text-align: center;
  font-size: 17px;
  line-height: 20px;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px dashed #cbd5e1;
  background: #ffffff;
  color: #64748b;
  font-size: 11px;
}

.photo-add-icon {
  margin-bottom: 5px;
  color: #1e80c1;
  font-size: 26px;
  line-height: 28px;
}

.error {
  margin-top: 12px;
  color: #dc2626;
  font-size: 12px;
}

.primary-btn {
  margin-top: 24px;
  width: 100%;
  border-radius: 999px;
  background: #1e80c1;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
}

.primary-btn[disabled] {
  opacity: 0.4;
}

.primary-btn::after {
  border: 0;
}

.footer-hint {
  margin-top: 10px;
  text-align: center;
  font-size: 11px;
}

.state,
.done {
  min-height: 70vh;
  padding: 80px 32px;
  box-sizing: border-box;
  text-align: center;
  color: #64748b;
}

.state-title,
.done-title {
  color: #0f172a;
  font-size: 18px;
  font-weight: 600;
}

.state-sub,
.done-sub {
  margin-top: 8px;
  font-size: 13px;
  line-height: 20px;
}

.retry {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 999px;
  background: #e8f1f8;
  color: #1e80c1;
}

.done-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 14px;
  border-radius: 50%;
  background: #dcfce7;
  color: #15803d;
  font-size: 28px;
  line-height: 56px;
}

.done-btn {
  width: 220px;
}
