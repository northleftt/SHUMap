<view class="page">
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar-title">Release 调试</view>
  </view>

  <view wx:if="{{loading}}" class="hint">装配中…</view>

  <view wx:elif="{{errorMessage}}" class="hint error">
    <view>装配失败</view>
    <view class="error-detail">{{errorMessage}}</view>
    <view class="retry" bindtap="boot">重试</view>
  </view>

  <block wx:else>
    <view class="section">
      <view class="section-title">Release</view>
      <view class="row">版本：{{version}}</view>
      <view class="row dim">{{releaseId}}</view>
    </view>

    <view class="section">
      <view class="section-title">校区（{{campuses.length}}）</view>
      <view wx:for="{{campuses}}" wx:key="id" class="campus">
        <view class="row">{{item.name}}（{{item.key}}）</view>
        <view class="row dim">{{item.mapVersionId}}</view>
        <view class="row dim">viewBox: {{item.viewBox}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">POI</view>
      <view class="row">总数：{{poiCount}}（楼宇 {{buildingCount}}）</view>
    </view>

    <view class="section">
      <view class="section-title">设施类型（{{facilityTypes.length}}）</view>
      <view wx:for="{{facilityTypes}}" wx:key="code" class="row">{{item.name}}（{{item.code}}）</view>
    </view>

    <view class="section">
      <view class="section-title">筛选组（{{filters.length}}）</view>
      <view wx:for="{{filters}}" wx:key="key" class="row">{{item.label}}（{{item.key}}）</view>
    </view>
  </block>
</view>
