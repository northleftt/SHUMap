/* M3 校车时刻表。配色对齐 Web 端 src/index.css 的设计令牌。 */

page {
  height: 100%;
  background: #f5f6f8;
}

.page {
  height: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 头部。整行左对齐，不用 justify-content: space-between —— 本行落在微信胶囊按钮
   （右上角「···」与「×」）的纵向区间里，任何右对齐的元素都会和它重合。 */
.header {
  display: flex;
  align-items: flex-end;
  padding: 48rpx 0 24rpx;
}

.title {
  flex: none;
  font-size: 44rpx;
  font-weight: 600;
  color: #0f172a;
}

/* 「如何坐车」入口：圆圈问号 + 灰色小字，紧贴大标题右侧。
   加圆圈问号是因为纯灰字读起来像说明文字而不是可点的东西——图标给出「这能点」的信号，
   但仍不做成按钮/主题蓝：它是补充说明的入口，不该跟页面主操作抢注意力。
   flex-direction 必须显式写 row：Skyline 下 view 默认是 column（见本文件 .stop-row-stops）。 */
.guide-link {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 20rpx;
  padding-bottom: 8rpx;
}

/* 圆圈用 border 画而不是用 ❓/🛈 这类字符：emoji 自带彩色，压不成与文字同一个灰。
   box-sizing: border-box 让 28rpx 是外径（含描边），否则实际会大 4rpx。 */
.guide-icon {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  margin-right: 8rpx;
  border: 2rpx solid #94a3b8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  color: #94a3b8;
}

.guide-text {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 校区选择卡 */
.route-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.stop-picker {
  flex: 1;
  min-width: 0;
}

.stop-label {
  font-size: 22rpx;
  color: #64748b;
}

.stop-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.swap-btn {
  width: 64rpx;
  height: 64rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e8f1f8;
  color: #1e80c1;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-divider {
  width: 2rpx;
  height: 56rpx;
  background: #e2e8f0;
  margin: 0 24rpx 0 8rpx;
  flex-shrink: 0;
}

.date-picker {
  flex-shrink: 0;
  text-align: right;
}

.date-label {
  font-size: 22rpx;
  color: #64748b;
}

.date-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #0f172a;
}

/* 离线快照提示 */
.offline-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #92400e;
  background: #fef3c7;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
}

/* 状态块 */
.state-block {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
}

.state-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
}

.state-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  white-space: pre-line;
}

/* 区块标题 */
.section-header {
  margin-top: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

/* 最近一班 hero 卡 */
.hero-row {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.hero-card {
  flex: 1;
  min-width: 0;
  border-radius: 48rpx;
  padding: 32rpx;
  color: #ffffff;
}

.hero-reservation {
  background: #1e80c1;
}

.hero-free {
  background: #77a988;
}

.hero-disabled {
  opacity: 0.45;
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  white-space: nowrap;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-time {
  margin-top: 12rpx;
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -1rpx;
}

/* 时刻网格（Skyline 对 grid 支持不完整，用 flex 两列） */
.grid-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0;
}

.grid-item-right {
  padding-left: 32rpx;
}

.grid-time {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.chip {
  font-size: 22rpx;
  font-weight: 500;
}

.chip-reservation {
  color: #1e80c1;
}

.chip-free {
  color: #64748b;
}

.grid-legend {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748b;
}

/* 上下车点 */
.stop-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 12rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.stop-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
}

.stop-row-border {
  border-bottom: 2rpx solid #e2e8f0;
}

/* 标签列放「上车点-预约车」这类复合标签，比旧版「上车点」宽 */
.stop-row-label {
  width: 160rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

/* 一行可挂多个站点：纵向排列 */
.stop-row-stops {
  flex: 1;
  min-width: 0;
}

.stop-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stop-entry + .stop-entry {
  margin-top: 12rpx;
}

.stop-row-name {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
  color: #475569;
}

.stop-row-action {
  margin-left: 12rpx;
  flex-shrink: 0;
  color: #1e80c1;
  font-size: 22rpx;
}

/* 自定义 tabBar 是页面渲染层内的覆盖组件（bottom:0 参照完整窗口），
   内容底部需抬 64px + 安全区，否则滚动到底时末行被 tab 栏遮住（同 .sheet 的处理） */
.page-footer-space {
  height: calc(48rpx + 64px + constant(safe-area-inset-bottom));
  height: calc(48rpx + 64px + env(safe-area-inset-bottom));
}

/* 班次预览弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  /* 自定义 tabBar 是页面渲染层内的覆盖组件：Skyline 页 bottom:0 参照完整窗口，
     底部需额外抬 64px 避免被 tab 栏遮住（同 map.wxss 的 sheet 处理） */
  padding: 24rpx 40rpx calc(48rpx + 64px + env(safe-area-inset-bottom));
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
}

/* 大标题里跟在时刻后面的方向（「07:00　嘉定校区 → 宝山校区」） */
.sheet-title-route {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #64748b;
}

/* 同一时刻两趟车时内容会变高，弹层内部自己滚，不把 tabBar 顶掉。
   max-height 直接给在 scroll-view 上（同 map.wxss 的 .layer-card-scroll）——
   它本身就是有界高度，不必再套一层 flex 容器。
   显式宽度 + border-box 是 Skyline 的老坑：不写会把长内容撑出右边界
   （见 map.wxss .modal-scroll 的同一条注释）。 */
.sheet-scroll {
  max-height: 60vh;
  width: 100%;
  box-sizing: border-box;
}

/* 一趟班次一段：第二段起加分隔线（非预约在上、预约在下） */
.trip {
  padding-top: 32rpx;
}

.trip-border {
  margin-top: 32rpx;
  border-top: 2rpx solid #e2e8f0;
}

.trip-meta {
  font-size: 24rpx;
  color: #64748b;
}

.sheet-close {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f5f6f8;
  color: #64748b;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-offline {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  padding: 24rpx 0;
}

/* 站点时间线 */
.timeline {
  margin-top: 32rpx;
}

.timeline-row {
  display: flex;
  gap: 24rpx;
}

.timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.dot-boarding {
  background: #1e80c1;
}

.dot-alighting {
  background: #77a988;
}

.rail-line {
  width: 2rpx;
  flex: 1;
  margin-top: 8rpx;
  background: #e2e8f0;
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
}

.timeline-body-nav,
.alighting-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-copy {
  min-width: 0;
  flex: 1;
}

.timeline-nav {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f1f8;
  color: #1e80c1;
  font-size: 21rpx;
  font-weight: 500;
}

.timeline-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.timeline-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.alighting-gap {
  margin-top: 16rpx;
}
