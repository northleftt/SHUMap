  height: 40px;
  border-radius: 50%;
  background-color: #e8f1f8;
  margin-right: 12px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.merchant-circle-icon {
  width: 20px;
  height: 20px;
}

.merchant-main {
  flex: 1;
