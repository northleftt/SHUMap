/* .section-head 默认自带左右 16px，给搜索首页这种无内边距容器用。
   详情卡 / 事件弹层已经有 20px 内边距，再套一层会把「楼内设施指引」挤出一格。 */
.detail-body .section-head,
.modal-scroll .section-head {
  padding: 0;
}

/* 信息字段行（对齐 Web 端 facts：图标 + 标签 + 值，divide-y 分隔） */
.fact-list {
  margin-top: 16px;
}

.fact-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #e8ebef;
}

.fact-icon {
