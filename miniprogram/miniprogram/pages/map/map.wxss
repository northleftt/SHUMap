  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 菜单 */
.menu-list {
  margin-top: 4px;
}

.menu-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 12px 0;
  border-bottom: 1px solid #e8ebef;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-name {
  font-size: 13px;
  line-height: 19px;
  color: #0f172a;
}

.menu-desc {
  margin-top: 2px;
  font-size: 12px;
  line-height: 17px;
  color: #94a3b8;
}

.menu-price {
  margin-left: 12px;
  font-size: 13px;
  line-height: 19px;
  font-weight: 600;
  color: #0f172a;
}

/* ---------------------------------------------------------------------------
   事件详情弹卡（对齐 Web 端 SheetModal：scrim + 底部圆角卡 + 把手）
   --------------------------------------------------------------------------- */
.modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 150;
  background-color: rgba(15, 23, 42, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-sheet {
  /* 限高对齐 Web 端移动端 SheetModal initialHeight 0.62：不限高时内容会把卡片
     顶出屏幕顶部（真机 Skyline 实测），且 scroll-view 拿不到有界高度就不滚动。 */
  max-height: 62vh;
  width: 100%;
  border-radius: 26px 26px 0 0;
  background-color: #ffffff;
  box-shadow: 0 -2px 18px rgba(15, 23, 42, 0.14);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-handle {
  padding: 10px 0 6px;
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.modal-handle-bar {
  width: 36px;
  height: 4px;
  border-radius: 999px;
  background-color: #e8ebef;
}

.modal-scroll {
  /* flex:1 + min-height:0：在限高的 .modal-sheet 里拿到有界高度才真正滚动；
     显式宽度 + border-box 防 Skyline 把内容撑出右边界（时间行文字溢出修复）。 */
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 4px 20px 32px;
}

.event-pills {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.event-pill {
  height: 24px;
  padding: 0 10px;
  border-radius: 999px;
  margin-right: 8px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.event-pill-icon {
  width: 14px;
  height: 14px;
  margin-right: 4px;
}

.event-pill-text {
  font-size: 11px;
  line-height: 15px;
  font-weight: 500;
}

.event-pill-info { background-color: #e8f1f8; }
.event-pill-info .event-pill-text { color: #1e80c1; }
.event-pill-warning { background-color: #fef3e2; }
.event-pill-warning .event-pill-text { color: #f59e0b; }
.event-pill-critical { background-color: #fdecec; }
.event-pill-critical .event-pill-text { color: #dc2626; }

.event-pill-status {
  background-color: #f5f6f8;
  font-size: 11px;
  line-height: 24px;
  font-weight: 500;
  color: #94a3b8;
}

.event-detail-title {
  margin-top: 10px;
}

.target-list {
  margin-top: 8px;
  border-radius: 16px;
  background-color: #f5f6f8;
  overflow: hidden;
}

.target-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12px 14px;
  border-bottom: 1px solid #e8ebef;
}

.target-icon {
