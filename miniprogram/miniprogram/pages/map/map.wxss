  border-radius: 14px;
  background-color: #fef3e2;
  color: #f59e0b;
  font-size: 13px;
  line-height: 19px;
}

/* 运营信息通栏横幅（severity 三色，通栏无左右留白，对齐 SeverityBanner） */
.event-banner {
  margin-top: 12px;
  padding: 12px 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.event-banner-info {
  background-color: #e8f1f8;
}

.event-banner-warning {
  background-color: #fef3e2;
}

.event-banner-critical {
