.fallback {
  padding: 160rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fallback-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.fallback-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
}

.fallback-url {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #94a3b8;
  word-break: break-all;
  text-align: center;
}

.fallback-btn {
  margin-top: 48rpx;
  width: 100%;
  border-radius: 999rpx;
  background: #1e80c1;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.fallback-btn::after {
  border: none;
}
