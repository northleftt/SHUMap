{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shumap",
  "account_id": "400623ade20e6d96cb546c98bcf3e33f",
  "main": "./worker/index-v2.ts",
  "compatibility_date": "2026-05-28",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "map.shutf.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  // 每天 18:00 UTC（北京 02:00）跑 worker/modules/maintenance.ts：清理过期隔离区照片。
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  // 可选 secret（不列入 required，缺了不影响部署，只是功能降级）：
  //   TENCENT_MAP_KEY           校车区间用时采样，缺则该轮 cron 跳过
  //   MINIPROGRAM_PROXY_SECRET  与云托管代理的共享口令，让公共限流按 openid
  //                             分桶而非按容器出口 IP 合计；缺则退回按 IP，
  //                             全体小程序用户共享一个桶。容器侧同值环境变量为
  //                             PROXY_SHARED_SECRET，说明见 miniprogram/cloudrun/README.md
  "secrets": {
    "required": [
      "SESSION_PEPPER"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASE_COORDINATOR",
        "class_name": "ReleaseCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-release-coordinator",
      "new_sqlite_classes": ["ReleaseCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shumap-v2",
      "database_id": "7b36d7cb-6352-409b-a520-175beee59f90",
      "migrations_dir": "migrations-v2"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_QUEUE",
        "queue": "shumap-import"
      }
    ],
    "consumers": [
      {
        "queue": "shumap-import"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "SHUMAP_BUCKET",
      "bucket_name": "shumap-assets"
    }
  ],
  // 预发环境：独立 worker / D1 / R2 / Queue，自定义域名 staging.map.shutf.com。
  // 部署：npm run deploy:staging；迁移：npm run migrations:staging。
  // 用法与灌数据流程见 docs/staging.md。注意 wrangler 非交互模式不读本文件的
  // account_id，所有 wrangler 命令需前置 CLOUDFLARE_ACCOUNT_ID（见 package.json 脚本）。
  "env": {
    "staging": {
      "name": "shumap-staging",
      // secrets / durable_objects 不被 env 继承（wrangler 部署时会警告），必须重复声明。
      "secrets": {
        "required": [
          "SESSION_PEPPER"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RELEASE_COORDINATOR",
            "class_name": "ReleaseCoordinator"
          }
        ]
      },
      "routes": [
        {
          "pattern": "staging.map.shutf.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shumap-v2-staging",
          "database_id": "8b8986ef-492d-447d-b0cb-4759604697fc",
          "migrations_dir": "migrations-v2"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "IMPORT_QUEUE",
            "queue": "shumap-import-staging"
          }
        ],
        "consumers": [
          {
            "queue": "shumap-import-staging"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "SHUMAP_BUCKET",
          "bucket_name": "shumap-assets-staging"
        }
      ]
    }
  }
}
